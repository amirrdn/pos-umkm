# SaaSPOS — Cursor / lean-ctx context exclusions (token savings)
# Source code tetap bisa dibaca on-demand via ctx_read.

# Dependencies & lockfiles (sangat besar, jarang perlu di-context)
**/node_modules/
**/package-lock.json

# Build output
**/dist/
**/dist-ssr/
**/build/
**/.vercel/
**/.cache/
**/.parcel-cache/

# Runtime & user-generated (binary / ephemeral)
backend/uploads/
**/*.log
logs/

# Git internals
.git/

# Database migration SQL (schema.prisma sudah cukup)
backend/prisma/migrations/

# Secrets & env
**/.env
**/.env.*
!.env.example

# Large static assets
frontend/src/assets/*.png
frontend/src/assets/*.jpg
frontend/src/assets/*.jpeg
frontend/src/assets/*.webp
frontend/src/assets/*.gif

# Planning docs (baca on-demand; hindari auto-index)
product_roadmap.md
task.md
plan_multi_outlet.md

# IDE / tooling noise
**/.vscode/
**/.idea/
**/*.bak
.cursor/rules/*.bak

# Test coverage & artifacts
coverage/
**/*.tsbuildinfo
.nyc_output/

# OS junk
.DS_Store
Thumbs.db
