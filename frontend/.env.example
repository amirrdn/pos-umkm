# URL backend API
# Dev: full URL backend (path di apiClient sudah diawali /api)
# Prod (Vercel): kosongkan — request same-origin, di-proxy lewat vercel.json
VITE_API_URL=http://localhost:3000

# Google OAuth Client ID (opsional — kosongkan jika belum siap)
VITE_GOOGLE_CLIENT_ID=

# Midtrans Snap client key (public — dipakai di browser)
# Sandbox: prefix SB-Mid-client-... | Production: Mid-client-...
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-NhCmZFQENLUx_vuLFj-AHwHq
VITE_MIDTRANS_IS_PRODUCTION=false
