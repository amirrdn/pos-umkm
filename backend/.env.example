# PostgreSQL (sesuaikan dengan docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_pos?schema=public"

# Server
PORT=3000

# JWT — ganti dengan string acak panjang di production
JWT_SECRET="change-me-in-production"

# Midtrans Sandbox (opsional, untuk QRIS)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_IS_PRODUCTION=false

# Email digest transfer DRAFT + verifikasi akun (opsional)
# Kosongkan SMTP_HOST untuk mode dev — tautan verifikasi dicetak di log backend.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false + App Password
APP_PUBLIC_URL="http://localhost:5173"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourdomain.com"
DIGEST_EMAIL_ENABLED=true
DIGEST_CRON="0 9 * * *"
