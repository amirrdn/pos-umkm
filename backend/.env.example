# PostgreSQL (sesuaikan dengan docker-compose.yml)
# DATABASE_URL digunakan oleh aplikasi pada saat runtime. Wajib menggunakan `app_user` (Non-Superuser) agar RLS berfungsi!
# Supabase production: pakai Session pooler port 5432 (bukan 6543) — RLS butuh set_config per sesi/koneksi.
# Wajib jalankan scripts/tenant_table_rls.sql di Supabase agar app_user bisa baca baris tenant sendiri.
# Supabase session pooler default pool_size=15 — batasi koneksi Prisma (total app+system < 15):
# PRISMA_APP_CONNECTION_LIMIT=7
# PRISMA_SYSTEM_CONNECTION_LIMIT=3
DATABASE_URL="postgresql://app_user:PasswordKuat123@localhost:5432/saas_pos?schema=public"

# DIRECT_URL digunakan oleh Prisma CLI (npx prisma db push / migrate). Wajib menggunakan `postgres` (Superuser) agar bisa mengubah skema.
DIRECT_URL="postgresql://postgres:pos_secure_pwd_2026@localhost:5432/saas_pos?schema=public"

# Server
PORT=3000

# JWT — wajib; ganti dengan string acak panjang di production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"

# CORS — origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Cookie sesi — production cross-origin (Vercel + Render) otomatis pakai none; override opsional
# COOKIE_SAME_SITE=none

# Midtrans Sandbox (wajib untuk QRIS & billing langganan)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_IS_PRODUCTION=false

# URL publik frontend (tautan verifikasi email)
APP_PUBLIC_URL="http://localhost:5173"

# ===== EMAIL =====
# Provider: gmail (lokal) | resend (production/Render) | kosong = dev (link di log)
# PENTING: Render free tier MEMBLOKIR SMTP port 587/465 — Gmail TIDAK jalan di Render.
#         Di Render pakai resend (HTTP API, bukan SMTP).
EMAIL_PROVIDER="gmail"

# --- Gmail / SMTP — cocok untuk development lokal ---
# Buat App Password: Google Account → Security → 2FA → App Passwords
GMAIL_ENABLED=true
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="email-kamu@gmail.com"
SMTP_PASS="app-password-16-karakter"
SMTP_FROM="SaaSPOS <email-kamu@gmail.com>"

# --- Resend — pakai ini di Render/production (HTTPS, tidak kena blokir port) ---
RESEND_ENABLED=false
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="SaaSPOS <noreply@umkm-pos.app>"
RESEND_TEMPLATE_ACCOUNT_VERIFICATION="account-email-verification"

# Notifikasi digest transfer DRAFT
DIGEST_EMAIL_ENABLED=true
DIGEST_CRON="0 9 * * *"

# Isi jika ingin mengaktifkan login dengan Google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
